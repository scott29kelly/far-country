# Far Country — environment variables
#
# Copy this file to `.env` at the repo root and fill in real values.
# The `.env` file is gitignored and must never be committed.
#
# Loaded automatically by the `far-country` CLI and the review UI launcher
# (apps/review/main.py) when present. Real environment variables always
# take precedence over .env values.

# --- Required for the live extraction path -------------------------------

# Anthropic API key. Used by `far-country extract` to call Claude for
# candidate descriptor extraction.
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ESV API token. Used by `far-country ingest esv` and downstream by the
# extraction step to fetch the canonical verse text the LLM works against.
# ESV is the canonical translation per CLAUDE.md non-negotiable #4 and
# ADR 0006. The LLM never recalls Scripture from training — it always
# receives the verse text from this API at runtime (ADR 0004).
# Get one at: https://api.esv.org/ (free for non-commercial / personal use)
ESV_API_KEY=

# --- Optional ------------------------------------------------------------

# Override the path to the canonical SQLite store.
# Defaults to data/canonical.sqlite resolved from CWD.
# FAR_COUNTRY_DB=data/canonical.sqlite

# Review UI bind address and port (apps/review).
# FAR_COUNTRY_REVIEW_HOST=127.0.0.1
# FAR_COUNTRY_REVIEW_PORT=8765
